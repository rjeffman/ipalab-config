ARG distro_image=fedora
ARG distro_tag=latest
FROM ${distro_image}:${distro_tag}

ARG extra_packages=""

ENV container=podman

RUN \
dnf update -y ; \
dnf -y install \
    python3 \
    sudo \
    bash \
    systemd \
    procps-ng \
    hostname \
    iputils \
    bind-utils \
    iproute \
    python3-libdnf5 \
    ${extra_packages} \
    ; \
dnf clean all; \
rm -rf /var/cache/dnf/;

STOPSIGNAL RTMIN+3

CMD ["/usr/sbin/init"]
