ARG distro_image=fedora
ARG distro_tag=latest
FROM ${distro_image}:${distro_tag}

ARG extra_packages=""
ARG extra_repositories_b64=""

ENV container=podman

COPY configure_repositories.py /usr/local/sbin/configure-repositories

RUN \
dnf update -y ; \
dnf -y install \
    python3 \
    sudo \
    bash \
    systemd \
    procps-ng \
    hostname \
    iputils \
    bind-utils \
    iproute \
    python3-libdnf5 \
    ; \
dnf clean all; \
rm -rf /var/cache/dnf/;

RUN if [ -n "${extra_repositories_b64}" ]; then \
        printf '%s' "${extra_repositories_b64}" | base64 -d | \
            python3 /usr/local/sbin/configure-repositories dnf; \
    fi && \
    if [ -n "${extra_packages}" ]; then \
        dnf -y install ${extra_packages}; \
    fi && \
    dnf clean all && rm -rf /var/cache/dnf/

STOPSIGNAL RTMIN+3

CMD ["/usr/sbin/init"]
